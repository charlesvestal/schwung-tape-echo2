{
  "title": "Tape Echo 2",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Vintage 3-head tape",
        "echo with spring",
        "reverb.",
        "",
        "Record EQ and tape",
        "saturation sit inside",
        "the feedback loop, so",
        "each repeat gets",
        "darker and more",
        "compressed."
      ]
    },
    {
      "title": "Main page",
      "lines": [
        "TIME SYNC FBK MIX",
        "TONE WID TAPE MODE",
        "",
        "TONE, TAPE and WID",
        "are macros. They move",
        "the real controls on",
        "ADVANCED and OUT."
      ]
    },
    {
      "title": "TIME",
      "lines": [
        "Delay in ms. Stays",
        "within the head MODE",
        "selected, so the two",
        "never fight.",
        "",
        "H1 reaches 69-177 ms,",
        "H2 to 339, H3 to 490."
      ]
    },
    {
      "title": "TONE",
      "lines": [
        "One tilt across BASS",
        "and TREBLE. Left is",
        "dark, right is bright."
      ]
    },
    {
      "title": "TAPE",
      "lines": [
        "Wear: moves W&F and",
        "AGE together.",
        "",
        "Age scales flutter, so",
        "an old tape runs",
        "worse. That is why",
        "they share a knob."
      ]
    },
    {
      "title": "WID",
      "lines": [
        "How far PONG swings,",
        "0 to 100.",
        "",
        "Turning it up from 0",
        "arms PONG. Turning",
        "PONG off by hand",
        "keeps it off."
      ]
    },
    {
      "title": "MODE",
      "lines": [
        "Which heads play, and",
        "whether the spring is",
        "in circuit.",
        "",
        "H1 H2 H3 H2+3",
        "H1+R H2+R H3+R",
        "H12+R H23+R H13+R",
        "H123R Rev",
        "",
        "Digits are heads. R is",
        "reverb. Rev is spring",
        "only."
      ]
    },
    {
      "title": "FBK",
      "lines": [
        "Feedback. Above about",
        "75% it self oscillates",
        "and builds.",
        "",
        "It gets loud. Ride",
        "ECHO."
      ]
    },
    {
      "title": "MIX",
      "lines": [
        "Dry against wet. 50%",
        "is both at unity, 0",
        "dry only, 100 wet",
        "only."
      ]
    },
    {
      "title": "SYNC",
      "lines": [
        "Locks the leading",
        "head to host tempo.",
        "DIV on OUT picks the",
        "note."
      ]
    },
    {
      "title": "ARM",
      "lines": [
        "The dub switch.",
        "",
        "Off stops feeding the",
        "tape while the",
        "repeats already on it",
        "wash out.",
        "",
        "The spring is fed",
        "before the gate, so a",
        "+R mode still",
        "reverberates."
      ]
    },
    {
      "title": "DRIVE",
      "lines": [
        "Preamp gain into the",
        "record stage. Higher",
        "settings saturate the",
        "tape."
      ]
    },
    {
      "title": "AGE",
      "lines": [
        "New, Used or Old tape.",
        "Older adds noise, HF",
        "loss, wobble and",
        "splice wear."
      ]
    },
    {
      "title": "W&F",
      "lines": [
        "Wow and flutter, plus",
        "a scrape band around",
        "6 Hz.",
        "",
        "0 is not still. The",
        "transport always",
        "moves a little, like",
        "the real one."
      ]
    },
    {
      "title": "BASS / TREBLE",
      "lines": [
        "Shelves on the echo",
        "path only. The dry",
        "stays as it is.",
        "",
        "Treble cut inside the",
        "loop makes each",
        "repeat darker than",
        "the last."
      ]
    },
    {
      "title": "RATE",
      "lines": [
        "The raw motor knob.",
        "TIME drives this, in",
        "ms."
      ]
    },
    {
      "title": "ECHO / VERB",
      "lines": [
        "Levels for the tape",
        "echo and the spring",
        "tank.",
        "",
        "VERB is only audible",
        "in a +R mode."
      ]
    },
    {
      "title": "PONG",
      "lines": [
        "Sends each repeat to",
        "the opposite side.",
        "",
        "Every head swaps on",
        "its own delay, so",
        "multi head modes",
        "separate too.",
        "",
        "Off, the echo is mono",
        "and matches the",
        "original exactly."
      ]
    },
    {
      "title": "DIV",
      "lines": [
        "The 11 tempo sync",
        "detents. The note",
        "follows the leading",
        "head, as on the",
        "hardware."
      ]
    },
    {
      "title": "TapeDelay presets",
      "lines": [
        "Old TapeDelay",
        "settings are read and",
        "converted.",
        "",
        "Time picks the head",
        "that reaches it.",
        "Feedback, mix, tone,",
        "division and width",
        "carry over.",
        "",
        "A patch names the",
        "module it wants, so",
        "point it here first",
        "with the converter in",
        "tools/."
      ]
    },
    {
      "title": "Credits",
      "lines": [
        "DSP: Tape Echo 2 by",
        "Dusk Audio, GPL-3.0.",
        "",
        "The core carries one",
        "Schwung change, a per",
        "head ping pong on the",
        "output tap. With PONG",
        "off it is the original",
        "sample for sample.",
        "",
        "Move port by",
        "athousanddetails.",
        "Macro page and legacy",
        "calibration by",
        "charlesvestal."
      ]
    }
  ]
}
